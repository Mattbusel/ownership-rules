    {
      "id": "ofac-faq402-divestment-after",
      "rule": "ofac-50",
      "as_of": "2025-06-01",
      "citation": {
        "doc": "OFAC FAQ 402",
        "url": "https://ofac.treasury.gov/faqs/402",
        "quote": "If one or more blocked persons divest their ownership stake such that the resulting combined ownership by blocked persons is less than 50 percent, the entity is no longer considered automatically to be a blocked entity."
      },
      "notes": "Covers future dealings only. FAQ 402 also says property already blocked stays blocked; that is a property question outside an ownership engine.",
