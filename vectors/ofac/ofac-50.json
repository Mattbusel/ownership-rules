{
  "suite": "ofac-50",
  "version": 1,
  "description": "OFAC 50 Percent Rule cases taken from OFAC FAQs 398, 399, 401 and 402 and the August 13, 2014 revised guidance. Each case quotes the text it encodes.",
  "cases": [
    {
      "id": "ofac-faq399-aggregate-across-programs",
      "rule": "ofac-50",
      "citation": {
        "doc": "OFAC FAQ 399",
        "url": "https://ofac.treasury.gov/faqs/399",
        "quote": "if Blocked Person X owns 25 percent of Entity A, and Blocked Person Y owns another 25 percent of Entity A, Entity A is considered to be blocked. ... the ownership interests of persons blocked under different OFAC sanctions programs are aggregated."
      },
      "listed": [
        {
          "id": "X",
          "lists": [
            "SDN"
          ],
          "programs": [
            "UKRAINE-EO13660"
          ]
        },
        {
          "id": "Y",
          "lists": [
            "SDN"
          ],
          "programs": [
            "IRAN"
          ]
        }
      ],
      "edges": [
        {
          "owner": "X",
          "owned": "A",
          "pct": 25
        },
        {
          "owner": "Y",
          "owned": "A",
          "pct": 25
        }
      ],
      "expect": {
        "A": {
          "verdict": "definitely",
          "proof_edges": [
            [
              "X",
              "A"
            ],
            [
              "Y",
              "A"
            ]
          ]
        }
      }
    },
