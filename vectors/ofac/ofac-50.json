    {
      "id": "ofac-faq398-control-without-ownership",
      "rule": "ofac-50",
      "citation": {
        "doc": "OFAC FAQ 398",
        "url": "https://ofac.treasury.gov/faqs/398",
        "quote": "OFAC's 50 Percent Rule speaks only to ownership and not to control. An entity that is controlled (but not owned 50 percent or more) by one or more blocked persons is not considered automatically blocked ... OFAC urges caution"
      },
      "listed": [
        {
          "id": "X",
          "lists": [
            "SDN"
          ]
        }
      ],
      "edges": [
        {
          "owner": "X",
          "owned": "A",
          "pct": null,
          "control": true
        },
        {
          "owner": "X",
          "owned": "B",
          "pct": 40,
          "control": true
        }
      ],
      "expect": {
        "A": {
          "verdict": "control_only",
          "proof_edges": [
            [
              "X",
              "A"
            ]
          ]
        },
        "B": {
          "verdict": "control_only",
          "proof_edges": [
            [
              "X",
              "B"
            ]
          ]
        }
      }
    },
    {
      "id": "ofac-2014-guidance-threshold",
      "rule": "ofac-50",
      "citation": {
        "doc": "OFAC Revised Guidance, Aug. 13, 2014",
        "url": "https://ofac.treasury.gov/media/6186/download?inline",
        "quote": "any entity owned in the aggregate, directly or indirectly, 50 percent or more by one or more blocked persons is itself considered to be a blocked person ... U.S. persons are advised to act with caution when considering a transaction with a non-blocked entity in which one or more blocked persons has a significant ownership interest that is less than 50 percent"
      },
      "listed": [
        {
          "id": "X",
          "lists": [
            "SDN"
          ]
        }
      ],
      "edges": [
        {
          "owner": "X",
          "owned": "A",
          "pct": 49.99
        },
        {
          "owner": "X",
          "owned": "B",
          "pct": 50
        }
      ],
      "expect": {
        "A": {
          "verdict": "not"
        },
        "B": {
          "verdict": "definitely"
        }
      }
    },
