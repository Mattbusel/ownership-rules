    {
      "id": "bis-744-8-program-scope",
      "rule": "bis-affiliates",
      "citation": {
        "doc": "15 CFR 744.8(a)(1)-(2)",
        "url": "https://www.ecfr.gov/current/title-15/subtitle-B/chapter-VII/subchapter-C/part-744/section-744.8",
        "quote": "These EAR controls also apply to any foreign affiliate of a listed entity that is owned, directly or indirectly, individually or in aggregate, 50 percent or more by one or more persons blocked pursuant to the programs listed in paragraph (a)(1) of this section."
      },
      "notes": "CUBA is not among the 744.8(a)(1) identifiers, so that SDN's stake does not count under the EAR rule (it still counts under OFAC's own rule).",
